<mso:customUI xmlns:mso="http://schemas.microsoft.com/office/2009/07/customui"><mso:ribbon><mso:qat/><mso:tabs><mso:tab id="mso_c1.Cronoaudit" label="Cronoaudit" insertBeforeQ="mso:TabView"><mso:group id="mso_c2.CronoauditAnalise" label="Com o agente de IA" autoScale="true"><mso:button id="CronoauditBtnAnalisar" label="Analisar" imageMso="ZoomPrintPreviewExcel" onAction="CronoauditAnalisar" visible="true"/><mso:button id="CronoauditBtnComparar" label="Comparar versões" imageMso="ReviewCompareMenu" onAction="CronoauditComparar" visible="true"/></mso:group><mso:group id="mso_c3.CronoauditSemIA" label="Sem IA (nada sai do computador)" autoScale="true"><mso:button id="CronoauditBtnSemIA" label="Relatório" imageMso="FileSaveAsWebPage" onAction="CronoauditSemIA" visible="true"/><mso:button id="CronoauditBtnCompararSemIA" label="Comparar" imageMso="ReviewCompareMenu" onAction="CronoauditCompararSemIA" visible="true"/><mso:button id="CronoauditBtnXml" label="Exportar XML" imageMso="ExportXmlFile" onAction="CronoauditExportarXml" visible="true"/></mso:group><mso:group id="mso_c4.CronoauditConfig" label="Ajustes" autoScale="true"><mso:button id="CronoauditBtnConfig" label="Configurar" imageMso="AdpProperties" onAction="CronoauditConfigurar" visible="true"/></mso:group></mso:tab></mso:tabs></mso:ribbon></mso:customUI>